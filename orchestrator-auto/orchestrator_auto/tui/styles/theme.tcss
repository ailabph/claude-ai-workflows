/* Orchestrator TUI Theme - Hacker Aesthetic */

/* Color palette - dark theme with green accents */
$primary: #00ff41;          /* Matrix green */
$secondary: #008f11;        /* Dark green */
$accent: #00d9ff;           /* Cyan accent */
$warning: #ffcc00;          /* Yellow warning */
$error: #ff3333;            /* Red error */
$background: #0d0d0d;       /* Near black */
$surface: #1a1a1a;          /* Dark gray surface */
$text: #c0c0c0;             /* Light gray text */
$text-muted: #666666;       /* Muted text */

/* Base screen styling */
Screen {
    background: $background;
}

/* Header styling */
Header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

/* Footer styling */
Footer {
    background: $surface;
    color: $text-muted;
}

/* Panel borders */
.panel {
    border: solid $secondary;
    background: $surface;
    padding: 0 1;
}

/* Status panel */
StatusPanel {
    height: auto;
    min-height: 8;
    border: solid $primary;
    background: $surface;
    padding: 0 1;
}

StatusPanel .title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

StatusPanel .stat-row {
    height: 1;
}

StatusPanel .stat-label {
    color: $text-muted;
    width: 12;
}

StatusPanel .stat-value {
    color: $text;
}

StatusPanel .stat-value.phase-active {
    color: $primary;
    text-style: bold;
}

StatusPanel .stat-value.phase-paused {
    color: $warning;
}

StatusPanel .stat-value.phase-completed {
    color: $accent;
}

StatusPanel .stat-value.phase-failed {
    color: $error;
}

/* Agent output panel */
AgentOutput {
    border: solid $secondary;
    background: $background;
    scrollbar-size: 1 1;
}

/* Log panel */
LogPanel {
    border: solid $accent;
    background: $background;
    scrollbar-size: 1 1;
}

/* Milestone list */
MilestoneList {
    border: solid $secondary;
    background: $surface;
    padding: 0 1;
}

MilestoneList .title {
    color: $primary;
    text-style: bold;
}

MilestoneList .empty-message {
    color: $text-muted;
    text-style: italic;
}

MilestoneList .progress-label {
    color: $text-muted;
}

MilestoneList ListView {
    background: transparent;
    height: auto;
}

/* Milestone items */
MilestoneItem {
    height: 1;
    padding: 0;
}

MilestoneItem .milestone-row {
    height: 1;
    width: 100%;
}

MilestoneItem .milestone-marker {
    width: 4;
}

MilestoneItem.milestone-pending .milestone-marker {
    color: $text-muted;
}

MilestoneItem.milestone-pending .milestone-title {
    color: $text-muted;
}

MilestoneItem.milestone-active .milestone-marker {
    color: $primary;
    text-style: bold;
}

MilestoneItem.milestone-active .milestone-title {
    color: $primary;
    text-style: bold;
}

MilestoneItem.milestone-completed .milestone-marker {
    color: $accent;
}

MilestoneItem.milestone-completed .milestone-title {
    color: $accent;
}

MilestoneItem.milestone-failed .milestone-marker {
    color: $error;
}

MilestoneItem.milestone-failed .milestone-title {
    color: $error;
}

/* Queue panel */
QueuePanel {
    border: solid $secondary;
    background: $surface;
    padding: 0 1;
    height: auto;
    min-height: 6;
}

QueuePanel .title {
    color: $primary;
    text-style: bold;
}

QueuePanel .empty-message {
    color: $text-muted;
    text-style: italic;
}

QueuePanel .progress-label {
    color: $text-muted;
    margin-top: 1;
}

QueuePanel ListView {
    background: transparent;
    height: auto;
    max-height: 10;
}

/* Queue list items */
QueueListItem {
    height: 1;
    padding: 0;
}

QueueListItem .queue-item-row {
    height: 1;
    width: 100%;
}

QueueListItem .queue-position {
    width: 3;
    color: $text-muted;
}

QueueListItem .queue-marker {
    width: 2;
}

QueueListItem .queue-feature {
    width: 1fr;
}

QueueListItem.queue-pending .queue-marker {
    color: $text-muted;
}

QueueListItem.queue-pending .queue-feature {
    color: $text-muted;
}

QueueListItem.queue-running .queue-marker {
    color: $primary;
    text-style: bold;
}

QueueListItem.queue-running .queue-feature {
    color: $primary;
    text-style: bold;
}

QueueListItem.queue-completed .queue-marker {
    color: $accent;
}

QueueListItem.queue-completed .queue-feature {
    color: $accent;
}

QueueListItem.queue-failed .queue-marker {
    color: $error;
}

QueueListItem.queue-failed .queue-feature {
    color: $error;
}

QueueListItem.queue-paused .queue-marker {
    color: $warning;
}

QueueListItem.queue-paused .queue-feature {
    color: $warning;
}

/* Watch panel */
WatchPanel {
    border: solid $secondary;
    background: $surface;
    padding: 0 1;
    height: auto;
    min-height: 12;
}

WatchPanel .title {
    color: $primary;
    text-style: bold;
}

WatchPanel .watch-info {
    height: auto;
}

WatchPanel .stat-row {
    height: 1;
}

WatchPanel .stat-label {
    color: $text-muted;
    width: 12;
}

WatchPanel .stat-value {
    color: $text;
}

WatchPanel .stat-value.phase-paused {
    color: $warning;
}

WatchPanel .stat-value.phase-completed {
    color: $accent;
}

WatchPanel .section-title {
    color: $text-muted;
    margin-top: 1;
}

WatchPanel .counts-row {
    height: 1;
}

WatchPanel .count-completed {
    color: $accent;
    width: 8;
}

WatchPanel .count-failed {
    color: $error;
    width: 8;
}

WatchPanel .count-paused {
    color: $warning;
    width: 8;
}

WatchPanel ListView {
    background: transparent;
    height: auto;
    max-height: 8;
}

/* Watch file items */
WatchFileItem {
    height: 1;
    padding: 0;
}

WatchFileItem .watch-file-row {
    height: 1;
    width: 100%;
}

WatchFileItem .watch-marker {
    width: 2;
}

WatchFileItem .watch-filename {
    width: 1fr;
}

WatchFileItem.watch-pending .watch-marker {
    color: $text-muted;
}

WatchFileItem.watch-pending .watch-filename {
    color: $text-muted;
}

WatchFileItem.watch-processing .watch-marker {
    color: $primary;
    text-style: bold;
}

WatchFileItem.watch-processing .watch-filename {
    color: $primary;
    text-style: bold;
}

WatchFileItem.watch-completed .watch-marker {
    color: $accent;
}

WatchFileItem.watch-completed .watch-filename {
    color: $accent;
}

WatchFileItem.watch-failed .watch-marker {
    color: $error;
}

WatchFileItem.watch-failed .watch-filename {
    color: $error;
}

WatchFileItem.watch-paused .watch-marker {
    color: $warning;
}

WatchFileItem.watch-paused .watch-filename {
    color: $warning;
}

WatchFileItem.watch-skipped .watch-marker {
    color: $text-muted;
}

WatchFileItem.watch-skipped .watch-filename {
    color: $text-muted;
    text-style: italic;
}

WatchFileItem.watch-converted .watch-marker {
    color: $accent;
}

WatchFileItem.watch-converted .watch-filename {
    color: $accent;
}

/* Input modal */
InputModal {
    align: center middle;
    width: 60;
    height: auto;
    background: $surface;
    border: heavy $primary;
    padding: 1 2;
}

InputModal Input {
    background: $background;
    border: solid $secondary;
    color: $text;
}

InputModal Input:focus {
    border: solid $primary;
}

InputModal .title {
    color: $primary;
    text-style: bold;
    text-align: center;
}

/* Buttons */
Button {
    background: $secondary;
    color: $text;
    border: none;
    min-width: 10;
}

Button:hover {
    background: $primary;
    color: $background;
}

Button:focus {
    background: $primary;
    color: $background;
}

/* Scrollbars */
Scrollbar {
    background: $surface;
}

Scrollbar > .scrollbar--thumb {
    background: $secondary;
}

Scrollbar > .scrollbar--thumb:hover {
    background: $primary;
}

/* Progress indicators */
ProgressBar {
    color: $primary;
}

ProgressBar > .bar--bar {
    background: $secondary;
}

ProgressBar > .bar--complete {
    background: $primary;
}
