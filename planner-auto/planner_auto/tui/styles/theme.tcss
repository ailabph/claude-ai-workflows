/* Review TUI theme — ported from orchestrator-auto palette */

/* --- Color variables --- */
$primary: #00ff41;
$accent: #00d9ff;
$warning: #ffcc00;
$error: #ff3333;
$background: #0d0d0d;
$surface: #1a1a1a;

/* --- App --- */
Screen {
    background: $background;
}

/* --- Layout grid --- */
#review-grid {
    layout: grid;
    grid-size: 4 1;
    grid-columns: 1fr 3fr;
    grid-gutter: 1;
    height: 1fr;
}

#sidebar {
    width: 100%;
    height: 100%;
    padding: 0;
}

#main-panel {
    width: 100%;
    height: 100%;
    padding: 0 1;
    border: solid $surface;
}

#log-container {
    height: 10;
    dock: bottom;
}

/* --- Panels --- */
.panel-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.panel-box {
    border: solid $surface;
    padding: 1;
    margin-bottom: 1;
}

/* --- Labels --- */
.field-label {
    color: $accent;
}

.field-value {
    color: $text;
}

/* --- Header / Footer --- */
Header {
    background: $surface;
    color: $primary;
}

Footer {
    background: $surface;
}

/* --- Responsive: stacked layout below 80 cols --- */
/* Textual doesn't support @media queries on width the same way CSS does,
   so responsive layout is handled in on_resize() via add_class/remove_class. */

.layout-stacked #review-grid {
    layout: vertical;
    grid-size: 1 1;
}

.layout-stacked #sidebar {
    height: auto;
    max-height: 12;
}

.layout-stacked #main-panel {
    height: 1fr;
}

.layout-wide #review-grid {
    grid-columns: 1fr 4fr;
}

/* --- Round list rows --- */
RoundRow {
    height: 1;
    padding: 0 1;
}

RoundRow.round-active {
    color: $accent;
}

RoundRow.round-go {
    color: #00ff41;
    text-style: bold;
}

RoundRow.round-completed {
    color: $text;
}

RoundRow.round-warning {
    color: $warning;
}

/* --- Convergence sparkline --- */
ConvergencePanel .cp-sparkline {
    color: $accent;
}

/* --- Current round --- */
CurrentRound .cr-phase {
    color: $accent;
}

CurrentRound .cr-idle {
    color: $text-muted;
}

CurrentRound .cr-retry {
    color: $warning;
}

CurrentRound .cr-elapsed {
    color: $text-muted;
}

/* --- Result summary --- */
#result-summary {
    padding: 1;
    height: auto;
}

/* --- Paused/Error states --- */
SessionPanel .sp-status-paused {
    color: $warning;
    text-style: bold;
}

SessionPanel .sp-status-error {
    color: $error;
    text-style: bold;
}

SessionPanel .sp-status-complete {
    color: #00ff41;
    text-style: bold;
}

/* --- Round detail --- */
RoundDetail {
    height: auto;
    padding: 1 2;
}

RoundDetail .rd-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

RoundDetail .rd-section {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

RoundDetail .rd-metric {
    padding: 0 0 0 2;
}

RoundDetail .rd-item {
    padding: 0 0 0 2;
}

RoundDetail .rd-keep {
    color: #00ff41;
    padding: 0 0 0 2;
}

RoundDetail .rd-trim {
    color: $warning;
    padding: 0 0 0 2;
}

RoundDetail .rd-note {
    color: $text-muted;
    padding: 0 0 0 2;
}

/* --- Modal screens (shared) --- */
DispositionScreen,
PlanScreen,
RawResponseScreen,
HelpScreen {
    align: center middle;
}

DispositionScreen #disp-container,
PlanScreen #plan-container,
RawResponseScreen #raw-container,
HelpScreen #help-container {
    border: solid $accent;
    background: $surface;
}

/* --- Disposition table --- */
DispositionScreen DataTable {
    height: 1fr;
}

/* --- Help screen --- */
HelpScreen .help-section {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

HelpScreen .help-row {
    height: 1;
}
