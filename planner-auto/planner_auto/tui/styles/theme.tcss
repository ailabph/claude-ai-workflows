/* Review TUI theme — ported from orchestrator-auto palette */

/* --- Color variables --- */
$primary: #00ff41;
$accent: #00d9ff;
$warning: #ffcc00;
$error: #ff3333;
$background: #0d0d0d;
$surface: #1a1a1a;

/* --- App --- */
Screen {
    background: $background;
}

/* --- Layout grid --- */
#review-grid {
    layout: grid;
    grid-size: 4 1;
    grid-columns: 1fr 3fr;
    grid-gutter: 1;
    height: 1fr;
}

#sidebar {
    width: 100%;
    height: 100%;
    padding: 0;
}

#main-panel {
    width: 100%;
    height: 100%;
    padding: 0 1;
    border: solid $surface;
}

#log-container {
    height: 10;
    dock: bottom;
}

/* --- Panels --- */
.panel-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.panel-box {
    border: solid $surface;
    padding: 1;
    margin-bottom: 1;
}

/* --- Labels --- */
.field-label {
    color: $accent;
}

.field-value {
    color: $text;
}

/* --- Header / Footer --- */
Header {
    background: $surface;
    color: $primary;
}

Footer {
    background: $surface;
}

/* --- Responsive: stacked layout below 80 cols --- */
/* Textual doesn't support @media queries on width the same way CSS does,
   so responsive layout is handled in on_resize() via add_class/remove_class. */

.layout-stacked #review-grid {
    layout: vertical;
    grid-size: 1 1;
}

.layout-stacked #sidebar {
    height: auto;
    max-height: 12;
}

.layout-stacked #main-panel {
    height: 1fr;
}

.layout-wide #review-grid {
    grid-columns: 1fr 4fr;
}

/* --- Round list rows --- */
RoundRow {
    height: 1;
    padding: 0 1;
}

RoundRow.round-active {
    color: $accent;
}

RoundRow.round-go {
    color: #00ff41;
    text-style: bold;
}

RoundRow.round-completed {
    color: $text;
}

RoundRow.round-warning {
    color: $warning;
}

/* --- Convergence sparkline --- */
ConvergencePanel .cp-sparkline {
    color: $accent;
}

/* --- Current round --- */
CurrentRound .cr-phase {
    color: $accent;
}

CurrentRound .cr-idle {
    color: $text-muted;
}

CurrentRound .cr-retry {
    color: $warning;
}

CurrentRound .cr-elapsed {
    color: $text-muted;
}

/* --- Result summary --- */
#result-summary {
    padding: 1;
    height: auto;
}

/* --- Paused/Error states --- */
SessionPanel .sp-status-paused {
    color: $warning;
    text-style: bold;
}

SessionPanel .sp-status-error {
    color: $error;
    text-style: bold;
}

SessionPanel .sp-status-complete {
    color: #00ff41;
    text-style: bold;
}

/* --- Round detail --- */
RoundDetail {
    height: auto;
    padding: 1 2;
}

RoundDetail .rd-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

RoundDetail .rd-section {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

RoundDetail .rd-metric {
    padding: 0 0 0 2;
}

RoundDetail .rd-item {
    padding: 0 0 0 2;
}

RoundDetail .rd-keep {
    color: #00ff41;
    padding: 0 0 0 2;
}

RoundDetail .rd-trim {
    color: $warning;
    padding: 0 0 0 2;
}

RoundDetail .rd-note {
    color: $text-muted;
    padding: 0 0 0 2;
}

/* --- Modal screens (shared) --- */
DispositionScreen,
PlanScreen,
RawResponseScreen,
HelpScreen {
    align: center middle;
}

DispositionScreen #disp-container,
PlanScreen #plan-container,
RawResponseScreen #raw-container,
HelpScreen #help-container {
    border: solid $accent;
    background: $surface;
}

/* --- Disposition table --- */
DispositionScreen DataTable {
    height: 1fr;
}

/* --- Help screen --- */
HelpScreen .help-section {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

HelpScreen .help-row {
    height: 1;
}

/* --- Session TUI layout --- */
#session-grid {
    layout: grid;
    grid-size: 4 1;
    grid-columns: 1fr 3fr;
    grid-gutter: 1;
    height: 1fr;
}

/* --- Session TUI responsive --- */
.layout-stacked #session-grid {
    layout: vertical;
    grid-size: 1 1;
}

.layout-stacked #sidebar {
    height: auto;
    max-height: 12;
}

.layout-wide #session-grid {
    grid-columns: 1fr 4fr;
}

/* --- Phase list rows --- */
PhaseList .pl-active {
    color: $accent;
    text-style: bold;
}

PhaseList .pl-completed {
    color: #00ff41;
}

PhaseList .pl-pending {
    color: $text-muted;
}

PhaseList .pl-paused {
    color: $warning;
    text-style: bold;
}

/* --- Context list --- */
ContextList .cl-file {
    color: $accent;
}

ContextList .cl-note {
    color: #00ff41;
}

ContextList .cl-synthesis {
    color: $warning;
}

/* --- Compact phase bar --- */
CompactPhaseBar {
    height: 1;
    padding: 0 1;
    color: $accent;
}

/* --- File/Note modal screens --- */
FileInputScreen,
NoteInputScreen {
    align: center middle;
}

FileInputScreen #file-container,
NoteInputScreen #note-container {
    border: solid $accent;
    background: $surface;
}

/* --- Chat view (discussion phase) --- */
#chat-view {
    height: 1fr;
}

ChatView #chat-scroll {
    height: 1fr;
}

ChatView .chat-user {
    color: #00ff41;
    margin: 0 0 1 0;
}

ChatView .chat-assistant {
    color: #00d9ff;
    margin: 0 0 1 0;
}

ChatView .chat-thinking {
    color: $text-muted;
    text-style: italic;
    margin: 0 0 1 0;
}

ChatView #chat-input-area {
    height: auto;
    max-height: 3;
    dock: bottom;
    border-top: solid $surface;
    padding: 0 1;
}

ChatView #chat-input {
    width: 100%;
}

/* --- Generation progress (planning phase) --- */
#generation-progress {
    height: auto;
    padding: 1 2;
}

GenerationProgress .gp-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

GenerationProgress .gp-active {
    color: $accent;
}

GenerationProgress .gp-done {
    color: #00ff41;
}

GenerationProgress .gp-pending {
    color: $text-muted;
}

/* --- Plan view (planning phase) --- */
#plan-view {
    height: 1fr;
}

PlanView .pv-title {
    text-style: bold;
    color: $primary;
}

PlanView .pv-meta {
    color: $accent;
}

PlanView .pv-warning {
    color: $warning;
}

PlanView .pv-ok {
    color: #00ff41;
}

PlanView #pv-scroll {
    height: 1fr;
    padding: 0 1;
}

/* --- Result summary (complete phase) --- */
ResultSummary .rs-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

ResultSummary .rs-check {
    color: #00ff41;
}

ResultSummary .rs-metric {
    color: $accent;
}

ResultSummary .rs-section {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

ResultSummary .rs-path {
    color: $text;
    padding: 0 0 0 2;
}

/* --- Blocker display (paused state) --- */
#blocker-display {
    padding: 2;
    height: auto;
}

/* --- Blocker screen modal --- */
BlockerScreen {
    align: center middle;
}

BlockerScreen #blocker-container {
    border: solid $warning;
    background: $surface;
}

BlockerScreen .bk-title {
    color: $warning;
}

BlockerScreen .bk-source {
    color: $accent;
}

BlockerScreen .bk-answer-label {
    color: $primary;
}

BlockerScreen .bk-hint {
    color: $text-muted;
}

/* --- Review widgets in session TUI --- */
#review-round-list {
    height: auto;
    max-height: 10;
}

#review-convergence {
    height: auto;
}

#review-current-round {
    height: auto;
}
